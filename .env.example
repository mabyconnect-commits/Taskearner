# ── Task Earner Africa — environment ─────────────────────────────────────────
# Copy to .env for local dev (optional; sensible localhost defaults are built in).
# On Vercel, set these in Project → Settings → Environment Variables.

# Postgres connection string.
# Local dev default: postgres://taskearner:taskearner@127.0.0.1:5432/taskearner
# On Vercel: add a Postgres store (Storage tab) and it injects POSTGRES_URL automatically.
DATABASE_URL=postgres://taskearner:taskearner@127.0.0.1:5432/taskearner

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated emails that get admin access (Admin Dashboard).
# The user must sign up / log in with one of these exact emails.
ADMIN_EMAILS=you@example.com

# Public URL of the deployed app (used for payment callback URLs).
# On Vercel this MUST be your real https domain, e.g. https://taskearner.vercel.app
APP_URL=http://localhost:5173

# ── Payments ────────────────────────────────────────────────────────────────
# "mock"  → deposits/payouts settle instantly, no external calls (default).
# "nekpay" → real NEKpay gateway (requires the values below).
PAYMENT_PROVIDER=mock

# NEKpay deposits (pay-in) — the app talks to NEKpay directly.
NEKPAY_MCH_ID=                 # merchant id (second account)
NEKPAY_KEY=                    # PAY-IN secret key (代收密钥) — never commit
NEKPAY_PAY_TYPE=               # channel/通道编码 for the market
NEKPAY_API_URL=https://api.nekpayment.com
# NEKPAY_CALLBACK_IPS=         # optional comma-separated gateway IPs (empty = signature-only)
# NEKPAY_QUERY_PATH=/query/order

# NEKpay withdrawals (pay-out) — via the fixed-IP relay for the SAME account.
NEKPAY_RELAY_URL=              # e.g. http://5.223.51.249:<relay-2 PORT>
NEKPAY_RELAY_SECRET=           # relay-2 RELAY_SECRET (from the box)
NAIRA_AUTO_MAX_NGN=65000       # auto-send ceiling; above it → manual admin queue
# NEKPAY_PAYOUT_AUTOSETTLE=1   # optional: auto-mark PAID from queried status

# The callback URLs NEKpay / the relay call back to (set on the deployed domain):
#   deposit callback : https://<APP_URL>/api/deposits/nekpay/callback   (must reply "success")
#   payout  callback : https://<APP_URL>/api/withdrawals/naira/callback
